# Database Configuration (PostgreSQL in production, SQLite async supported for local dev)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/reseller_bot
# Example SQLite: sqlite+aiosqlite:///./reseller_bot.db
DATABASE_URL=sqlite+aiosqlite:///./reseller_bot.db

# Admin Configuration (Comma-separated Telegram user IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Support & Contact
SUPPORT_USERNAME=your_telegram_support_handle

# Cryptography & Security
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_base64_fernet_encryption_key_here

# App Performance & Caching
PRODUCT_CACHE_TTL=60
CHECKOUT_EXPIRY_MINUTES=30
LOG_LEVEL=INFO

# SMSPool API (for Codex/OpenAI, Nvidia, YouTube verification)
SMSPOOL_API_KEY=your_smspool_api_key_here
SMS_COMMISSION_RATE=0.60
OPENAI_SMS_COMMISSION_RATE=0.80
NVIDIA_SMS_COMMISSION_RATE=0.80

# GrizzlySMS API (for WhatsApp OTP numbers — USA & UK only)
# Get your API key at: https://grizzlysms.com/profile/settings
GRIZZLYSMS_API_KEY=your_grizzlysms_api_key_here
GRIZZLYSMS_COMMISSION_RATE=0.80
